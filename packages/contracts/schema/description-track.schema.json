            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "tStart": {
                "type": "number",
                "minimum": 0
              },
              "tEnd": {
                "type": "number",
                "minimum": 0
              },
              "text": {
                "type": "string"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "frameRef": {
                "type": "string"
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "ai-draft",
                  "verified",
                  "skipped"
                ]
              },
              "skipReason": {
                "type": "string"
              },
              "audioUrl": {
                "type": "string"
              },
              "placementRule": {
                "type": "string"
              },
              "verifiedAt": {
                "type": "string"
              },
              "verifiedBy": {
                "type": "string"
              },
              "durationSec": {
                "type": "number",
