            "skippedCount": {
              "type": "integer",
              "minimum": 0
            },
            "overlapCount": {
              "type": "integer",
              "minimum": 0
            },
            "generatedAt": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "sourceSrt": {
              "type": "string"
