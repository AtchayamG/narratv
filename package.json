{
  "name": "narratv-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "NarraTV: AI-Driven Scene Audio Description for Fire TV and Blind/Low-Vision Viewers",
  "license": "MIT",
  "packageManager": "yarn@4.6.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "build": "yarn workspaces foreach -pt run build",
    "typecheck": "tsc --build",
    "lint": "eslint . --ext .ts,.tsx",
    "pipeline:local": "yarn workspace @narratv/pipeline run local",
    "review": "yarn workspace @narratv/pipeline run review"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1124.0",
    "@aws-sdk/client-polly": "^3.1124.0",
    "@aws-sdk/client-s3": "^3.1124.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.5",
    "aws-cdk": "^2.1139.0",
    "aws-cdk-lib": "^2.267.0",
    "constructs": "^10.8.1",
    "eslint": "^8.57.1",
    "fast-check": "^3.23.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
